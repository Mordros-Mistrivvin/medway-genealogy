---
import '../styles/global.css';
const { title = 'Medway Genealogy Research', description = 'Research into the Medway, Meadway and associated Dorset families.' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <div class="nav">
        <a class="brand" href={base}>Medway Genealogy Research</a>
        <nav aria-label="Primary">
          <a href={`${base}research/latest-findings/`}>Latest</a>
          <a href={`${base}research/project-review/`}>Review</a>
          <a href={`${base}research/direct-line/`}>Direct line</a>
          <a href={`${base}research/mary-galley/`}>Mary Galley</a>
          <a href={`${base}research/early-line/`}>Earlier line</a>
          <a href={`${base}research/evidence-inventory/`}>Evidence</a>
          <a href={`${base}research/research-priorities/`}>Next research</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <strong>Medway Genealogy Research.</strong> Evidence-led reconstruction of the Medway / Meadway families of Dorset and Southampton. Proved facts, candidate identities and open hypotheses are kept distinct; conclusions change when better primary evidence appears.
    </footer>
  </body>
</html>
